# ── 발급 필요한 API 키 4종 ──────────────────────────────────────
# 1) KOSIS 국가통계포털  https://kosis.kr/openapi/  (즉시발급, 무료)
#    → 주민등록세대수 / 주택보급률 / 소비심리지수
KOSIS_API_KEY=

# 2) 공공데이터포털  https://www.data.go.kr/  (활용신청 후 1~2시간)
#    → 미분양주택현황 (국토부 통계누리 직접접속 차단으로 우회 필수)
DATA_GO_KR_KEY=

# 3) 한국은행 ECOS  https://ecos.bok.or.kr/api/  (즉시발급, 무료)
#    → CD(91일) / 주택담보대출금리
ECOS_API_KEY=

# 4) 카카오 디벨로퍼스  https://developers.kakao.com/  (즉시발급, 무료)
#    → 반경내 시설검색(교통·주거·교육) + 정적지도 반경원 이미지
KAKAO_REST_KEY=

# 5) 카카오 JavaScript 키 — 지도 반경원 캡쳐용 (REST 키와 별개)
#    콘솔 > 앱 키 > JavaScript 키 / 플랫폼 > Web 에 http://localhost 등록 필수
KAKAO_JS_KEY=
